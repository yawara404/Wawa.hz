<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (Windows Server) 用の設定。
  - Apache では同梱の .htaccess が同じ役割を担います (.htaccess は IIS では無視されます)。
  - マークダウン資料や機密ファイルへの直接アクセスを拒否します。
  - この web.config はテーマ ディレクトリ直下に置かれます。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- ドキュメント / 機密ファイルへの直接アクセスを拒否 -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".markdown" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
        <!-- 隠しディレクトリへの直接アクセスを拒否 -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
