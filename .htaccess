# Block direct web access to markdown documentation and sensitive files
<FilesMatch "\.(md|markdown|json|lock|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
